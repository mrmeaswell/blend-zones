{
  "_comment": "The blend-zone definition. This file plus db/schema.sql is what you edit to fork the service for a new blend zone. The API validates stage advancement against 'requires' and the frontend renders 'fields' dynamically, so no code changes are needed for a new workflow.",

  "tool_name": "Bay Log",
  "department_a": "Automotive (owns the workflow)",
  "department_b": "IT (owns build/maintain)",
  "subject_label": "Vehicle",
  "subject_plural": "Vehicles",
  "new_item_label": "New repair order",
  "ticket_prefix": "T-",
  "ticket_start": 1001,

  "subject_fields": [
    { "key": "label", "label": "Vehicle", "type": "text", "placeholder": "2014 Honda Civic", "required": true },
    { "key": "vin", "label": "VIN", "type": "text", "placeholder": "1HGFA16526L000000", "required": false },
    { "key": "plate", "label": "Plate", "type": "text", "required": false },
    { "key": "mileage", "label": "Mileage", "type": "number", "required": false }
  ],

  "stages": [
    {
      "key": "intake",
      "label": "Intake",
      "short": "IN",
      "pill": "#334155",
      "bg": "#f1f5f9",
      "text": "#334155",
      "description": "Vehicle checked in, customer complaint recorded.",
      "fields": [
        { "key": "complaint", "label": "Customer complaint", "type": "textarea", "required": true },
        { "key": "mileage_in", "label": "Mileage at intake", "type": "number", "required": true },
        { "key": "notes", "label": "Intake notes", "type": "textarea", "required": false }
      ],
      "requires": { "fields": ["complaint", "mileage_in"] }
    },
    {
      "key": "diagnosis",
      "label": "Diagnosis",
      "short": "DX",
      "pill": "#0369a1",
      "bg": "#e0f2fe",
      "text": "#0369a1",
      "description": "Student diagnoses the fault and records findings.",
      "fields": [
        { "key": "findings", "label": "Diagnostic findings", "type": "textarea", "required": true },
        { "key": "codes", "label": "Trouble codes", "type": "text", "placeholder": "P0301, P0420", "required": false },
        { "key": "notes", "label": "Additional notes", "type": "textarea", "required": false }
      ],
      "requires": { "fields": ["findings"] }
    },
    {
      "key": "estimate_approval",
      "label": "Estimate Approval",
      "short": "EA",
      "pill": "#b45309",
      "bg": "#fef3c7",
      "text": "#b45309",
      "description": "Estimate presented; requires an explicit sign-off before work begins.",
      "fields": [
        { "key": "estimate_hours", "label": "Estimated labor hours", "type": "number", "required": true },
        { "key": "estimate_parts", "label": "Estimated parts cost", "type": "number", "required": false },
        { "key": "notes", "label": "Estimate notes", "type": "textarea", "required": false }
      ],
      "requires": { "fields": ["estimate_hours"], "signoff": true }
    },
    {
      "key": "in_bay",
      "label": "In Bay",
      "short": "BAY",
      "pill": "#7c3aed",
      "bg": "#ede9fe",
      "text": "#6d28d9",
      "description": "Repair work performed in the bay.",
      "fields": [
        { "key": "work_performed", "label": "Work performed", "type": "textarea", "required": true },
        { "key": "actual_hours", "label": "Actual labor hours", "type": "number", "required": false },
        { "key": "notes", "label": "Notes", "type": "textarea", "required": false }
      ],
      "requires": { "fields": ["work_performed"] }
    },
    {
      "key": "qc_inspection",
      "label": "QC Inspection",
      "short": "QC",
      "pill": "#0f766e",
      "bg": "#ccfbf1",
      "text": "#0f766e",
      "description": "Instructor inspects the work. Requires sign-off and at least one photo.",
      "fields": [
        { "key": "inspection_notes", "label": "Inspection notes", "type": "textarea", "required": true },
        { "key": "road_tested", "label": "Road tested", "type": "checkbox", "required": false }
      ],
      "requires": { "fields": ["inspection_notes"], "signoff": true, "attachments": 1 }
    },
    {
      "key": "ready",
      "label": "Ready for Pickup",
      "short": "RDY",
      "pill": "#15803d",
      "bg": "#dcfce7",
      "text": "#15803d",
      "description": "Work complete, customer notified.",
      "fields": [
        { "key": "customer_notified", "label": "Customer notified", "type": "checkbox", "required": true },
        { "key": "notes", "label": "Pickup notes", "type": "textarea", "required": false }
      ],
      "requires": { "fields": ["customer_notified"] }
    },
    {
      "key": "closed",
      "label": "Closed",
      "short": "CLS",
      "pill": "#57534e",
      "bg": "#f5f5f4",
      "text": "#57534e",
      "description": "Repair order closed and archived to the audit log.",
      "fields": [
        { "key": "notes", "label": "Closing notes", "type": "textarea", "required": false }
      ],
      "requires": {},
      "terminal": true
    }
  ],

  "roles": {
    "signoff_roles": ["instructor", "staff"],
    "_comment": "Only these roles may sign off a stage that requires one. Students can fill fields and advance non-signoff stages."
  }
}
