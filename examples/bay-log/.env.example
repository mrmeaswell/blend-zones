# Bay Log settings template. On a server these live in /etc/blendzone.env (0600).
# Copy to .env for local runs. Never commit a real .env.

# Session signing key: generate with  python -c 'import secrets; print(secrets.token_urlsafe(48))'
BZ_SECRET_KEY=replace-with-a-long-random-value

# Auth. Keep DEV_AUTH=0 anywhere reachable by others.
BZ_REQUIRE_AUTH=1
BZ_DEV_AUTH=0
BZ_ANON_ROLE=viewer

# Cloudflare Access (optional perimeter)
BZ_CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
BZ_CF_ACCESS_AUD=replace-with-access-application-aud-tag

# Role mapping
BZ_STAFF_EMAILS=instructor@example.edu
BZ_STAFF_DOMAIN=@example.edu
BZ_STUDENT_DOMAIN=@student.example.edu

# Frontend on another origin (optional)
BZ_CORS_ORIGINS=
BZ_API_BASE=

# Paths and limits (defaults shown)
BZ_DB_PATH=/var/lib/blendzone/baylog.db
BZ_UPLOAD_DIR=/var/lib/blendzone/uploads
BZ_WORKFLOW_PATH=config/workflow.json
BZ_LTI_CONFIG=config/lti_config.json
BZ_SESSION_TTL_HOURS=12
BZ_MAX_UPLOAD_BYTES=15728640
